# Cadena de conexión de Neon (Dashboard → Connect). Se acepta postgresql:// o postgresql+psycopg://
DATABASE_URL=postgresql://usuario:contrasena@host.neon.tech/neondb?sslmode=require

# Orígenes permitidos por CORS, en formato JSON. 8501 es el puerto por defecto de Streamlit.
CORS_ORIGINS=["http://localhost:8501"]

# Obligatorio, mínimo 32 caracteres. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET_KEY=
# Opcional: duración del token en minutos (por defecto 60).
# ACCESS_TOKEN_EXPIRE_MINUTES=60


# Obligatorio. Se obtiene en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcionales: modelo (por defecto gemini-3.5-flash) y timeout por intento en segundos (por defecto 20).
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_TIMEOUT_SECONDS=20
# Opcional: tiempo límite del examen en minutos (por defecto 60). El envío tardío se califica igual.
# EXAM_TIME_LIMIT_MINUTES=60
