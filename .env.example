# Cadena de conexión de Neon (Dashboard → Connect). Se acepta postgresql:// o postgresql+psycopg://
DATABASE_URL=postgresql://usuario:contrasena@host.neon.tech/neondb?sslmode=require

# Orígenes permitidos por CORS, en formato JSON. 8501 es el puerto por defecto de Streamlit.
CORS_ORIGINS=["http://localhost:8501"]

# Obligatorio, mínimo 32 caracteres. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET_KEY=
# Opcional: duración del token en minutos (por defecto 60).
# ACCESS_TOKEN_EXPIRE_MINUTES=60


GEMINI_API_KEY=